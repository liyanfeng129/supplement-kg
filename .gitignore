data/*
datasets/
__pycache__/
*.pyc
.venv/
.env
.vscode/
/runs/

# Each fetch run writes an immutable timestamped directory under data/pubmed/runs/.
# Manifests (query, counts, PMID lists, hashes) are the reproducible record and
# are tracked; the raw abstract payloads they describe are not. Git never
# descends into an excluded directory, so every directory on the path is
# re-included and only the raw/ leaf is excluded.
!data/pubmed/
!data/pubmed/runs/
!data/pubmed/runs/*/
data/pubmed/runs/*/raw/
!data/pubmed/runs/*/manifests/

# Same rule for DSLD label runs: manifests tracked, raw label payloads not.
!data/dsld/
!data/dsld/runs/
!data/dsld/runs/*/
data/dsld/runs/*/raw/
!data/dsld/runs/*/manifests/
