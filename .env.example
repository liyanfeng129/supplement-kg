# NCBI E-utilities credentials (PubMed retrieval).
#
# Get a key: https://account.ncbi.nlm.nih.gov/ -> Account settings -> API Key Management
# A key raises the E-utilities rate limit from 3 req/s to 10 req/s. Optional,
# but a multi-claim corpus run will be throttled hard without one.
NCBI_API_KEY=

# Contact address NCBI uses to reach you before blocking abusive traffic.
# Requested by their usage policy; send a real address.
NCBI_EMAIL=

# Anthropic API key, used to extract product purpose and risk from DSLD label
# statements (DSLD carries no purpose/risk fields of its own -- see
# notebooks/DSP_processing.ipynb).
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# DSLD (NIH ODS) Label API key, issued through api.data.gov -- the shared
# federal API gateway that fronts DSLD.
# Get a key: https://api.data.gov/signup/  (arrives by email, usable at once)
# Sent as the X-Api-Key header. Optional: DSLD serves unauthenticated traffic
# at 1,000 requests/hour/IP, which makes a full per-label sweep take days.
DSLD_API_KEY=

# Run notifications (engine/notify.py): a long run emails when it finishes,
# when the model becomes unavailable, and once if too many labels fail.
# Sent through Gmail's SMTP server with an app password, not the account
# password: Google account -> Security -> 2-Step Verification -> App passwords.
# All three must be set, or notify only logs.
NOTIFY_GMAIL_ADDRESS=
NOTIFY_GMAIL_APP_PASSWORD=
NOTIFY_TO=
